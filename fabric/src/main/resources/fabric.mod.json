{
  "schemaVersion": 1,
  "id": "sensible_survival",
  "version": "${version}",
  "name": "Sensible Survival",
  "description": "A collection of sensible survival gameplay tweaks and fixes.",
  "authors": [
    "Daedelus"
  ],
  "contact": {
    "homepage": "https://github.com/ZsoltMolnarrr/Sensible-Survival",
    "sources": "https://github.com/ZsoltMolnarrr/Sensible-Survival"
  },
  "license": "GPL-3.0",
  "icon": "icon.png",
